{
  "_comment": "Machine-local, gitignored. Personal allows and env knobs go HERE, never in settings.json — they go stale and would travel to other machines otherwise. This bundle pushes after every auto-commit (CLAUDE_AUTO_PUSH=1 in settings.json); set 0 here to keep one machine local-only.",
  "env": {
    "CLAUDE_AUTO_PUSH": "1"
  },
  "permissions": {
    "allow": [
      "Bash(env)",
      "Bash(command -v *)",
      "Bash(git config *)",
      "Bash(git check-ignore *)",
      "Bash(gh auth *)"
    ]
  }
}
